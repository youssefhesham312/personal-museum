# Browser configuration (safe to expose in the frontend bundle).
#
# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
# Use the publishable/anon key ONLY. Never put a service-role or secret key
# in a VITE_* variable: Vite inlines every VITE_* value into public JS.
#
# For Cloudflare Pages, set these in the Pages build environment instead of
# committing them. See DEPLOYMENT.md. The placeholder values below are rejected
# by `npm run check:deploy` and by the browser config guard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# Edge Function secrets (set with `supabase secrets set`, never in this file
# and never in the browser bundle):
#
#   SUPABASE_URL                 provided automatically by Supabase
#   SUPABASE_SERVICE_ROLE_KEY    provided automatically by Supabase
#   MUSEUM_CLEANUP_SECRET        a random string, at least 24 characters
#   MUSEUM_RATE_LIMIT_PEPPER     a random string used to hash client IPs
#   MUSEUM_ALLOWED_ORIGINS       comma-separated exact origins, or * for development
#   MUSEUM_CREATE_LIMIT_PER_HOUR default 10 (clamped to 1-100)
#   MUSEUM_CLEANUP_BATCH         default 25 (clamped to 1-100)
#
# Cloudflare R2 photo storage (required for share links; the bucket must stay
# private). These are Edge Function secrets only. Do not add them to VITE_*.
#
#   R2_ACCOUNT_ID          32-character hexadecimal Cloudflare account id.
#                          Example shape: 0123456789abcdef0123456789abcdef
#   R2_ACCESS_KEY_ID       Access Key ID from an R2 API token with
#                          "Object Read & Write" on this bucket.
#   R2_SECRET_ACCESS_KEY   Secret Access Key for that token (shown once).
#   R2_BUCKET              Private bucket name, e.g. personal-museum-photos.
#                          3-63 lowercase letters, digits or hyphens.
#   R2_ENDPOINT            Optional. Defaults to
#                          https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#                          Set only for a jurisdiction-specific endpoint.
#
# R2's SigV4 signing region is always `auto`; there is no R2_REGION variable.
# Presigned upload URLs live for 15 minutes. Download URLs live for at most
# one hour and are clamped to the museum's remaining seven-day lifetime.
# ---------------------------------------------------------------------------
